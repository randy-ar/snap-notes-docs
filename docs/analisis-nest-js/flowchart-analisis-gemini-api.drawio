<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="Flowchart Gemini API" id="uml_flowchart">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Container Tunggal -->
        <mxCell id="container" value="Sistem Ekstraksi Data OCR ke JSON" style="swimlane;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="40" width="500" height="880" as="geometry" />
        </mxCell>

        <!-- Nodes -->
        <mxCell id="start" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="container">
          <mxGeometry x="235" y="50" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="step1" value="Menerima Data Teks OCR &amp;amp; Koordinat Spasial" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="container">
          <mxGeometry x="155" y="120" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="step2" value="Membentuk Prompt Instruksi Ekstraksi" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="container">
          <mxGeometry x="155" y="220" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="step3" value="Mendefinisikan Skema Zod untuk Output JSON" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="container">
          <mxGeometry x="155" y="320" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="step4" value="Memanggil API generateContent() dengan config.responseFormat" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="container">
          <mxGeometry x="155" y="420" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="step5" value="Menerima Response Teks JSON" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="container">
          <mxGeometry x="155" y="520" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="step6" value="Parsing &amp;amp; Validasi JSON dengan Zod Schema" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="container">
          <mxGeometry x="155" y="620" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="dec" value="Valid?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="container">
          <mxGeometry x="210" y="720" width="80" height="80" as="geometry" />
        </mxCell>

        <mxCell id="step7" value="Mengembalikan Data JSON Terstruktur" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="container">
          <mxGeometry x="40" y="730" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="step8" value="Melempar Error Validasi" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="container">
          <mxGeometry x="340" y="730" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="end" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="container">
          <mxGeometry x="235" y="820" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="container" source="start" target="step1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="container" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="container" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="container" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="container" source="step4" target="step5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="container" source="step5" target="step6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="container" source="step6" target="dec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="container" source="dec" target="step7" value="Ya">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="container" source="dec" target="step8" value="Tidak">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="container" source="step7" target="end">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="100" y="835" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="container" source="step8" target="end">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="400" y="835" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
