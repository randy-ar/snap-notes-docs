<mxfile host="app.diagrams.net">
  <diagram name="Tinjauan Data Ekstraksi" id="seq-tinjauan-data">
    <mxGraphModel dx="1707" dy="775" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Lifeline: Pengguna (Actor) -->
        <mxCell id="ll_actor" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&amp;quot;curved&amp;quot;:0,&amp;quot;rounded&amp;quot;:0};" value="«actor»&lt;br&gt;&lt;b&gt;Pengguna&lt;/b&gt;" vertex="1">
          <mxGeometry height="900" width="100" x="100" y="70" as="geometry" />
        </mxCell>
        <mxCell id="act_actor" parent="ll_actor" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;newEdgeStyle={&amp;quot;curved&amp;quot;:0,&amp;quot;rounded&amp;quot;:0};" value="" vertex="1">
          <mxGeometry height="800" width="10" x="45" y="80" as="geometry" />
        </mxCell>

        <!-- Lifeline: ScannerPage (View) -->
        <mxCell id="ll_page" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&amp;quot;curved&amp;quot;:0,&amp;quot;rounded&amp;quot;:0};" value="ScannerPage" vertex="1">
          <mxGeometry height="900" width="130" x="350" y="70" as="geometry" />
        </mxCell>
        <mxCell id="act_page" parent="ll_page" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;newEdgeStyle={&amp;quot;curved&amp;quot;:0,&amp;quot;rounded&amp;quot;:0};" value="" vertex="1">
          <mxGeometry height="800" width="10" x="60" y="80" as="geometry" />
        </mxCell>

        <!-- Lifeline: ReceiptViewModel (ViewModel) -->
        <mxCell id="ll_vm" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&amp;quot;curved&amp;quot;:0,&amp;quot;rounded&amp;quot;:0};" value="ReceiptViewModel" vertex="1">
          <mxGeometry height="900" width="160" x="600" y="70" as="geometry" />
        </mxCell>
        <mxCell id="act_vm" parent="ll_vm" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;newEdgeStyle={&amp;quot;curved&amp;quot;:0,&amp;quot;rounded&amp;quot;:0};" value="" vertex="1">
          <mxGeometry height="800" width="10" x="75" y="80" as="geometry" />
        </mxCell>

        <!-- Lifeline: Receipt (Model) -->
        <mxCell id="ll_receipt" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&amp;quot;curved&amp;quot;:0,&amp;quot;rounded&amp;quot;:0};" value="Receipt" vertex="1">
          <mxGeometry height="900" width="120" x="850" y="70" as="geometry" />
        </mxCell>
        <mxCell id="act_receipt" parent="ll_receipt" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;newEdgeStyle={&amp;quot;curved&amp;quot;:0,&amp;quot;rounded&amp;quot;:0};" value="" vertex="1">
          <mxGeometry height="800" width="10" x="55" y="80" as="geometry" />
        </mxCell>

        <!-- Lifeline: ReceiptItem (Model) -->
        <mxCell id="ll_item" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&amp;quot;curved&amp;quot;:0,&amp;quot;rounded&amp;quot;:0};" value="ReceiptItem" vertex="1">
          <mxGeometry height="900" width="120" x="1100" y="70" as="geometry" />
        </mxCell>
        <mxCell id="act_item" parent="ll_item" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;newEdgeStyle={&amp;quot;curved&amp;quot;:0,&amp;quot;rounded&amp;quot;:0};" value="" vertex="1">
          <mxGeometry height="800" width="10" x="55" y="80" as="geometry" />
        </mxCell>

        <!-- Messages -->
        <!-- 1. Menampilkan Formulir (Precondition: AI parsing is complete, Page is rendered) -->
        <mxCell id="msg_render" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;" value="Tampilkan data hasil ekstraksi di halaman pratinjau">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="140" as="sourcePoint" />
            <mxPoint x="155" y="140" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 2. Pengguna Mengubah Data Toko/Tanggal -->
        <mxCell id="msg_edit_field" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="editField(fieldName, value)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="155" y="180" as="sourcePoint" />
            <mxPoint x="410" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_update_field_vm" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="updateReceiptField(fieldName, value)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="420" y="210" as="sourcePoint" />
            <mxPoint x="675" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_update_receipt_prop" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="updateProperty(fieldName, value)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="685" y="240" as="sourcePoint" />
            <mxPoint x="905" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_notify_1" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;" value="notifyListeners() (updateState)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="675" y="280" as="sourcePoint" />
            <mxPoint x="420" y="280" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_refresh_ui_1" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;" value="Perbarui tampilan data pada formulir">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="310" as="sourcePoint" />
            <mxPoint x="155" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 3. Pengguna Mengubah Detail Item Belanja -->
        <mxCell id="msg_edit_item" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="editItemDetail(index, fieldName, value)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="155" y="360" as="sourcePoint" />
            <mxPoint x="410" y="360" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_modify_item_vm" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="modifyReceiptItem(index, fieldName, value)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="420" y="390" as="sourcePoint" />
            <mxPoint x="675" y="390" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_update_item_at" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="updateItemAt(index, fieldName, value)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="685" y="420" as="sourcePoint" />
            <mxPoint x="905" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_update_item_prop" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="updateProperty(fieldName, value)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="915" y="450" as="sourcePoint" />
            <mxPoint x="1155" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_notify_2" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;" value="notifyListeners() (hitung ulang totalAmount)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="675" y="490" as="sourcePoint" />
            <mxPoint x="420" y="490" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_refresh_ui_2" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;" value="Perbarui nominal total pengeluaran belanja">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="520" as="sourcePoint" />
            <mxPoint x="155" y="520" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Alt Frame: Validasi rekapitulasi nominal total -->
        <mxCell id="frame_val" parent="1" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=80;height=30;" value="Alt" vertex="1">
          <mxGeometry height="300" width="1150" x="90" y="550" as="geometry" />
        </mxCell>
        <mxCell id="txt_val_fail" parent="frame_val" style="text;html=1;" value="&lt;b&gt;[Terdapat Selisih Perhitungan Total Lokal]&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" relative="1" width="300" as="geometry">
            <mxPoint x="90" y="10" as="offset" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="msg_alert_diff" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;" value="Tampilkan peringatan selisih nominal &amp; minta tinjau ulang">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="600" as="sourcePoint" />
            <mxPoint x="155" y="600" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="line_val" parent="frame_val" style="line;strokeWidth=1;dashed=1;labelPosition=center;verticalLabelPosition=bottom;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;html=1;whiteSpace=wrap;" value="" vertex="1">
          <mxGeometry height="10" width="1150" y="90" as="geometry" />
        </mxCell>
        <mxCell id="txt_val_ok" parent="frame_val" style="text;html=1;" value="&lt;b&gt;[Perhitungan Matematis Valid / Sesuai]&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="250" x="90" y="100" as="geometry" />
        </mxCell>

        <!-- Skenario Sukses Simpan / Konfirmasi -->
        <mxCell id="msg_click_simpan" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="clickSimpanButton()">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="155" y="680" as="sourcePoint" />
            <mxPoint x="410" y="680" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_confirm_receipt" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="confirmReceipt()">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="420" y="710" as="sourcePoint" />
            <mxPoint x="675" y="710" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_set_step_confirmed" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;" value="state = ReceiptScanStep.confirmed">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="675" y="750" as="sourcePoint" />
            <mxPoint x="420" y="750" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg_navigate_success" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;" value="Navigator.pushReplacement(UploadSuccessPage)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="790" as="sourcePoint" />
            <mxPoint x="155" y="790" as="targetPoint" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
