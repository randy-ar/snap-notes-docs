<mxfile host="app.diagrams.net">
  <diagram name="SKPL-F-015 Ubah Pengeluaran Manual" id="SKPL-F-015">
    <mxGraphModel dx="2100" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- ==================== LIFELINES ==================== -->
        <!-- 1. <<actor>> Masyarakat -->
        <mxCell id="ll_M" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" value="«actor»&lt;br&gt;&lt;b&gt;Masyarakat&lt;/b&gt;" vertex="1">
          <mxGeometry height="850" width="120" x="40" y="70" as="geometry" />
        </mxCell>
        <mxCell id="act_M" parent="ll_M" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" value="" vertex="1">
          <mxGeometry height="730" width="10" x="55" y="80" as="geometry" />
        </mxCell>

        <!-- 2. PengeluaranFormPage -->
        <mxCell id="ll_PFP" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" value="view :&lt;br&gt;&lt;b&gt;PengeluaranFormPage&lt;/b&gt;" vertex="1">
          <mxGeometry height="850" width="180" x="220" y="70" as="geometry" />
        </mxCell>
        <mxCell id="act_PFP" parent="ll_PFP" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" value="" vertex="1">
          <mxGeometry height="730" width="10" x="85" y="80" as="geometry" />
        </mxCell>

        <!-- 3. PengeluaranViewModel -->
        <mxCell id="ll_PVM" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" value="viewModel :&lt;br&gt;&lt;b&gt;PengeluaranViewModel&lt;/b&gt;" vertex="1">
          <mxGeometry height="850" width="160" x="460" y="70" as="geometry" />
        </mxCell>
        <mxCell id="act_PVM" parent="ll_PVM" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" value="" vertex="1">
          <mxGeometry height="540" width="10" x="75" y="160" as="geometry" />
        </mxCell>

        <!-- 4. PengeluaranService -->
        <mxCell id="ll_PS" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" value="service :&lt;br&gt;&lt;b&gt;PengeluaranService&lt;/b&gt;" vertex="1">
          <mxGeometry height="850" width="150" x="680" y="70" as="geometry" />
        </mxCell>
        <mxCell id="act_PS" parent="ll_PS" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" value="" vertex="1">
          <mxGeometry height="400" width="10" x="70" y="240" as="geometry" />
        </mxCell>

        <!-- 5. DioClient -->
        <mxCell id="ll_DC" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" value="client :&lt;br&gt;&lt;b&gt;DioClient&lt;/b&gt;" vertex="1">
          <mxGeometry height="850" width="130" x="890" y="70" as="geometry" />
        </mxCell>
        <mxCell id="act_DC" parent="ll_DC" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" value="" vertex="1">
          <mxGeometry height="260" width="10" x="60" y="320" as="geometry" />
        </mxCell>

        <!-- 6. Web Service -->
        <mxCell id="ll_WS" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" value="«actor»&lt;br&gt;&lt;b&gt;Web Service&lt;/b&gt;" vertex="1">
          <mxGeometry height="850" width="130" x="1080" y="70" as="geometry" />
        </mxCell>
        <mxCell id="act_WS" parent="ll_WS" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" value="" vertex="1">
          <mxGeometry height="160" width="10" x="60" y="360" as="geometry" />
        </mxCell>

        <!-- ==================== MESSAGES ==================== -->
        <!-- 1. Interaksi UI -->
        <mxCell id="msg_1" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="mengisi field (deskripsi, jumlah, tanggal, kategori, dll.)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="160" as="sourcePoint" />
            <mxPoint x="305" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 2. Klik simpan -->
        <mxCell id="msg_2" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="clickSaveButton() / simpanPengeluaran()">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="200" as="sourcePoint" />
            <mxPoint x="305" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 3. Form passing parameter ke ViewModel -->
        <mxCell id="msg_3" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="updatePengeluaran(id, deskripsi, jumlah, ...)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="315" y="240" as="sourcePoint" />
            <mxPoint x="535" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 4. ViewModel setLoading -->
        <mxCell id="act_PVM_self" parent="ll_PVM" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" value="" vertex="1">
          <mxGeometry height="35" width="10" x="85" y="250" as="geometry" />
        </mxCell>
        <mxCell id="msg_4" edge="1" parent="1" style="html=1;align=left;spacingLeft=2;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;" target="act_PVM_self" value="&lt;span style=&quot;text-align: center;&quot;&gt;_setLoading(true)&lt;/span&gt;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="585" y="260" />
            </Array>
            <mxPoint x="545" y="250" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- 5. ViewModel memanggil Service -->
        <mxCell id="msg_5" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="updatePengeluaran(id, dataMap)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="545" y="320" as="sourcePoint" />
            <mxPoint x="750" y="320" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 6. Service menyusun HTTP request -->
        <mxCell id="msg_6" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="put('/api/pengeluaran/$id', data)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="360" as="sourcePoint" />
            <mxPoint x="950" y="360" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 7. DioClient Request API -->
        <mxCell id="msg_7" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="HTTP PUT /api/pengeluaran/{id}">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="960" y="400" as="sourcePoint" />
            <mxPoint x="1140" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ==================== ALT FRAME (BERHASIL / GAGAL) ==================== -->
        <mxCell id="frame_alt" parent="1" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=60;height=30;" value="Alt" vertex="1">
          <mxGeometry height="330" width="1090" x="80" y="440" as="geometry" />
        </mxCell>
        <mxCell id="frame_alt_succ_text" parent="frame_alt" style="text;html=1;" value="&lt;b&gt;[Update Berhasil]&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" relative="1" width="120" as="geometry">
            <mxPoint x="70" y="10" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- SUCCESS -->
        <!-- 8. API Response -->
        <mxCell id="msg_succ_1" edge="1" parent="frame_alt" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;" value="HTTP 200 OK">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1060" y="50" as="sourcePoint" />
            <mxPoint x="880" y="50" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 9. DioClient membalas ke Service -->
        <mxCell id="msg_succ_2" edge="1" parent="frame_alt" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;" value="Response (JSON)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="870" y="80" as="sourcePoint" />
            <mxPoint x="680" y="80" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 10. Service ke ViewModel -->
        <mxCell id="msg_succ_3" edge="1" parent="frame_alt" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;" value="void / True">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="670" y="110" as="sourcePoint" />
            <mxPoint x="465" y="110" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 11. ViewModel stop loading dan info view -->
        <mxCell id="msg_succ_4" edge="1" parent="frame_alt" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;" value="notifyListeners() : isLoading = false">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="455" y="150" as="sourcePoint" />
            <mxPoint x="235" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 12. View memunculkan Toast Berhasil & Pop Navigasi -->
        <mxCell id="msg_succ_5" edge="1" parent="frame_alt" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;" value="Tampilkan Toast(Success) &amp; Navigator.pop(context)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="225" y="170" as="sourcePoint" />
            <mxPoint x="20" y="170" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- SEPARATOR -->
        <mxCell id="frame_alt_sep" parent="frame_alt" style="line;strokeWidth=1;dashed=1;labelPosition=center;verticalLabelPosition=bottom;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;html=1;whiteSpace=wrap;" value="" vertex="1">
          <mxGeometry height="10" width="1090" y="200" as="geometry" />
        </mxCell>
        <mxCell id="frame_alt_fail_text" parent="frame_alt" style="text;html=1;" value="&lt;b&gt;[Update Gagal]&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="160" x="70" y="215" as="geometry" />
        </mxCell>

        <!-- FAIL -->
        <!-- 13. API Error -->
        <mxCell id="msg_fail_1" edge="1" parent="frame_alt" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;" value="HTTP Error (4xx / 500)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="870" y="240" as="sourcePoint" />
            <mxPoint x="680" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 14. Service lempar exception -->
        <mxCell id="msg_fail_2" edge="1" parent="frame_alt" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;" value="throw Exception(errorMsg)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="670" y="270" as="sourcePoint" />
            <mxPoint x="465" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 15. ViewModel tangkap error -->
        <mxCell id="act_PVM_fail" parent="ll_PVM" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};" value="" vertex="1">
          <mxGeometry height="35" width="10" x="85" y="705" as="geometry" />
        </mxCell>
        <mxCell id="msg_fail_3" edge="1" parent="1" style="html=1;align=left;spacingLeft=2;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;curved=0;" target="act_PVM_fail" value="&lt;span style=&quot;text-align: center;&quot;&gt;notifyListeners() : isLoading = false &amp; simpan error&lt;/span&gt;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="585" y="720" />
            </Array>
            <mxPoint x="545" y="710" as="sourcePoint" />
          </mxGeometry>
        </mxCell>

        <!-- 16. View munculkan Toast gagal -->
        <mxCell id="msg_fail_4" edge="1" parent="frame_alt" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;" value="Tampilkan Toast Error (gagal menyimpan)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="225" y="320" as="sourcePoint" />
            <mxPoint x="20" y="320" as="targetPoint" />
          </mxGeometry>
        </mxCell>

      </root>
