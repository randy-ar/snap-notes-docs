          <mxGeometry x="370" y="1500" width="280" height="230" as="geometry" />
        </mxCell>

        <mxCell id="legend_flow" value="&lt;b&gt;ALUR STRUKTURISASI (SKPL-F-007):&lt;/b&gt;&#xa;&#xa;1. Pengguna ambil foto struk&#xa;2. ML Kit OCR ekstrak rawText (on-device)&#xa;3. Flutter kirim rawText + image ke backend&#xa;4. Backend upload image ke Storage&#xa;5. Backend kirim rawText ke Gemini AI&#xa;6. &lt;b&gt;Gemini AI strukturisasi teks &#x2192; JSON&lt;/b&gt;&#xa;   {namaToko, tanggal, items[], total}&#xa;7. Backend validasi JSON&#xa;8. Backend simpan ke DB (transaction)&#xa;9. Return data terstruktur ke Flutter&#xa;10. Flutter tampilkan untuk review&#xa;&#xa;&lt;b&gt;Aktor Utama:&lt;/b&gt; Gemini AI&#xa;&lt;b&gt;Aktor Pendukung:&lt;/b&gt; Web Service" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=10;fontFamily=Times New Roman;size=15;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="1500" width="290" height="230" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
