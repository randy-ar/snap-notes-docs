        <mxCell id="note1" value="Dependency Rule:&#xa;Presentation → Domain → Data&#xa;(Layer hanya bergantung pada layer di bawahnya)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#000000;fontSize=10;fontFamily=Times New Roman;size=15;" vertex="1" parent="1">
          <mxGeometry x="1380" y="100" width="180" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="note2" value="«stereotype»&#xa;UML 2.0 Notation:&#xa;• «abstract» = Abstract Class&#xa;• «interface» = Interface&#xa;• «use» = Dependency&#xa;• «implement» = Realization&#xa;• «extend» = Generalization&#xa;• «layer» = Package/Layer" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#000000;fontSize=10;fontFamily=Times New Roman;size=15;" vertex="1" parent="1">
          <mxGeometry x="1380" y="200" width="180" height="130" as="geometry" />
        </mxCell>
        
      </root>
