<mxfile host="app.diagrams.net" modified="2024-05-30T13:15:00.000Z" agent="SnapNotes" version="22.1.0" type="device">
  <diagram name="Class Diagram - 5 Class Tambah Pemasukan" id="5class-pemasukan">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="Class Diagram - Use Case Tambah Pemasukan&#xa;(5 Class Sederhana)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="400" height="40" as="geometry" />
        </mxCell>
        
        <!-- ==================== CLASS 1: PAGE (UI) ==================== -->
        <mxCell id="page" value="TambahPemasukanPage&#xa;(Presentation Layer)&#xa;--&#xa;--&#xa;+ build(BuildContext): Widget&#xa;+ onSubmit(FormData): void&#xa;--&#xa;Menampilkan form input:&#xa;- Deskripsi&#xa;- Jumlah&#xa;- Tanggal&#xa;- Kategori (dropdown)&#xa;- Tombol Simpan" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;fillColor=#e3f2fd;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="200" height="240" as="geometry" />
        </mxCell>
        
        <!-- ==================== CLASS 2: CUBIT ==================== -->
        <mxCell id="cubit" value="PemasukanCubit&#xa;(State Management)&#xa;--&#xa;- tambahPemasukanUC: TambahPemasukanUseCase&#xa;- getPemasukanUC: GetPemasukanUseCase&#xa;+ state: PemasukanState&#xa;--&#xa;+ tambahPemasukan(params): void&#xa;+ loadPemasukan(): void&#xa;--&#xa;Fungsi:&#xa;- Menerima event dari UI&#xa;- Memanggil UseCase&#xa;- Mengelola state aplikasi&#xa;- Memberitahu UI untuk rebuild" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;fillColor=#fff3e0;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="360" y="100" width="240" height="280" as="geometry" />
        </mxCell>
        
        <!-- ==================== CLASS 3: USECASE ==================== -->
        <mxCell id="usecase" value="TambahPemasukanUseCase&#xa;(Domain Layer - Business Logic)&#xa;--&#xa;- repository: PemasukanRepository&#xa;--&#xa;+ call(params):&#xa;  Future&lt;Either&lt;Failure, Pemasukan&gt;&gt;&#xa;--&#xa;Alur Kerja:&#xa;1. Validasi input&#xa;2. Buat entity Pemasukan&#xa;3. Panggil repository.create()&#xa;4. Return hasil&#xa;--&#xa;Tidak tahu tentang:&#xa;- HTTP / API&#xa;- Database&#xa;- UI / Widget" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=50;fillColor=#ffffff;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="660" y="100" width="260" height="300" as="geometry" />
        </mxCell>
        
        <!-- ==================== CLASS 4: REPOSITORY IMPL ==================== -->
        <mxCell id="repo" value="PemasukanRepositoryImpl&#xa;(Data Layer)&#xa;--&#xa;- remoteDataSource: PemasukanRemoteDataSource&#xa;- localDataSource: PemasukanLocalDataSource&#xa;--&#xa;+ create(Pemasukan): Either&lt;Failure, Pemasukan&gt;&#xa;+ read(String): Either&lt;Failure, Pemasukan&gt;&#xa;+ getAll(): Either&lt;Failure, List&lt;Pemasukan&gt;&gt;&#xa;--&#xa;Alur Kerja:&#xa;1. Konversi Entity → Model&#xa;2. Kirim HTTP POST ke Backend&#xa;3. Simpan response ke cache local&#xa;4. Return Entity ke UseCase&#xa;--&#xa;Implements: PemasukanRepository&#xa;(Interface di Domain Layer)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;fillColor=#fff8e1;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="660" y="450" width="260" height="320" as="geometry" />
        </mxCell>
        
        <!-- ==================== CLASS 5: ENTITY (DOMAIN) ==================== -->
        <mxCell id="entity" value="Pemasukan&#xa;(Domain Layer - Entity)&#xa;--&#xa;- id: String&#xa;- penggunaId: String&#xa;- deskripsi: String&#xa;- jumlah: double&#xa;- tanggal: DateTime&#xa;- kategoriId: String?&#xa;- catatan: String?&#xa;- createdAt: DateTime&#xa;- updatedAt: DateTime&#xa;--&#xa;+ copyWith(): Pemasukan&#xa;--&#xa;Fungsi:&#xa;- Object domain murni&#xa;- Tidak bergantung framework&#xa;- Bisa dipakai di Flutter &amp; Backend&#xa;-extends Equatable" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;fillColor=#e8f5e9;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="360" y="450" width="220" height="300" as="geometry" />
        </mxCell>
        
        <!-- ==================== BACKEND (External) ==================== -->
        <mxCell id="backend" value="«external»&#xa;PemasukanController&#xa;(Backend NestJS)&#xa;--&#xa;--&#xa;+ @Post() create(dto)&#xa;+ @Get() findAll()&#xa;+ @Put() update()&#xa;+ @Delete() remove()&#xa;--&#xa;REST API Endpoint:&#xa;POST /api/pemasukan&#xa;GET /api/pemasukan&#xa;PUT /api/pemasukan/:id&#xa;DELETE /api/pemasukan/:id" style="swimlane;fontStyle=3;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=50;fillColor=#e1f5fe;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="200" height="220" as="geometry" />
        </mxCell>
        
        <!-- ==================== DEPENDENCIES / RELATIONSHIPS ==================== -->
        
        <!-- Page -> Cubit -->
        <mxCell id="dep1" value="«use»&#xa;Event: onSubmit()" style="endArrow=open;endFill=0;strokeWidth=2;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;dashed=1;fontStyle=2;fontSize=11;fontFamily=Times New Roman;" edge="1" parent="1" source="page" target="cubit">
          <mxGeometry x="-0.1" y="-15" relative="1" as="geometry">
            <mxPoint x="15" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- Cubit -> UseCase -->
        <mxCell id="dep2" value="«use»&#xa;Call: tambahPemasukan()" style="endArrow=open;endFill=0;strokeWidth=2;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;dashed=1;fontStyle=2;fontSize=11;fontFamily=Times New Roman;" edge="1" parent="1" source="cubit" target="usecase">
          <mxGeometry x="-0.1" y="-15" relative="1" as="geometry">
            <mxPoint x="15" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- UseCase -> Repo -->
        <mxCell id="dep3" value="«use»&#xa;Call: repository.create()" style="endArrow=open;endFill=0;strokeWidth=2;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;dashed=1;fontStyle=2;fontSize=11;fontFamily=Times New Roman;" edge="1" parent="1" source="usecase" target="repo">
          <mxGeometry x="-0.1" relative="1" as="geometry">
            <mxPoint x="10" y="0" as="offset" />
            <Array as="points">
              <mxPoint x="790" y="400" />
              <mxPoint x="790" y="450" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- UseCase -> Entity -->
        <mxCell id="dep4" value="«use»&#xa;Create entity" style="endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;dashed=1;fontStyle=2;fontSize=10;fontFamily=Times New Roman;" edge="1" parent="1" source="usecase" target="entity">
          <mxGeometry x="0.2" relative="1" as="geometry">
            <mxPoint x="-15" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- Repo -> Entity -->
        <mxCell id="dep5" value="«use»&#xa;Konversi Entity ↔ Model" style="endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;dashed=1;fontStyle=2;fontSize=10;fontFamily=Times New Roman;" edge="1" parent="1" source="repo" target="entity">
          <mxGeometry x="0.3" y="10" relative="1" as="geometry">
            <mxPoint x="-20" y="10" as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- Repo -> Backend -->
        <mxCell id="dep6" value="«http»&#xa;POST /pemasukan" style="endArrow=open;endFill=0;strokeWidth=2;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;dashed=1;fontStyle=2;fontSize=11;fontFamily=Times New Roman;" edge="1" parent="1" source="repo" target="backend">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint x="20" y="0" as="offset" />
            <Array as="points">
              <mxPoint x="660" y="610" />
              <mxPoint x="280" y="610" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- Cubit -> Page (Return/Callback) -->
        <mxCell id="dep7" value="«emit»&#xa;State: Success/Error" style="endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;dashed=1;fontStyle=2;fontSize=10;fontFamily=Times New Roman;" edge="1" parent="1" source="cubit" target="page">
          <mxGeometry x="0.1" y="15" relative="1" as="geometry">
            <mxPoint x="-10" y="15" as="offset" />
            <Array as="points">
              <mxPoint x="300" y="380" />
              <mxPoint x="180" y="380" />
              <mxPoint x="180" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- ==================== LEGEND & NOTES ==================== -->
        <mxCell id="legend" value="KETERANGAN 5 CLASS:&#xa;┌─────────────────────────────────────────┐&#xa;│  1. PAGE (UI Layer)                     │&#xa;│     - Menampilkan form                  │&#xa;│     - Menerima input user               │&#xa;├─────────────────────────────────────────┤&#xa;│  2. CUBIT (State Management)              ││&#xa;│     - Bridge antara UI dan Domain       │&#xa;│     - Mengelola state                   │&#xa;├─────────────────────────────────────────┤&#xa;│  3. USECASE (Business Logic)              │&#xa;│     - Aturan bisnis                     │&#xa;│     - Validasi data                     │&#xa;├─────────────────────────────────────────┤&#xa;│  4. REPO IMPL (Data Layer)              │&#xa;│     - Akses ke API                      │&#xa;│     - Local cache                       │&#xa;├─────────────────────────────────────────┤&#xa;│  5. ENTITY (Domain Layer)               │&#xa;│     - Object bisnis murni               │&#xa;│     - Shared dengan Backend               │&#xa;└─────────────────────────────────────────┘&#xa;&#xa;Dependency Rule:&#xa;UI → Cubit → UseCase → Repo → Backend&#xa;(Tidak boleh terbalik!)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#000000;fontSize=10;fontFamily=Times New Roman;size=15;" vertex="1" parent="1">
          <mxGeometry x="960" y="100" width="260" height="400" as="geometry" />
        </mxCell>
        
        <!-- Alur Data Note -->
        <mxCell id="alur" value="ALUR TAMBAH PEMASUKAN:&#xa;┌─────────────────────────────────────────┐&#xa;│  1. User isi form di PAGE              │&#xa;│     ↓                                   │&#xa;│  2. PAGE kirim event ke CUBIT           │&#xa;│     ↓                                   │&#xa;│  3. CUBIT panggil USECASE               │&#xa;│     ↓                                   │&#xa;│  4. USECASE buat ENTITY                 │&#xa;│     ↓                                   │&#xa;│  5. USECASE panggil REPO.create()       │&#xa;│     ↓                                   │&#xa;│  6. REPO kirim HTTP ke BACKEND          │&#xa;│     ↓                                   │&#xa;│  7. BACKEND simpan ke DB                │&#xa;│     ↓                                   │&#xa;│  8. BACKEND return response             │&#xa;│     ↓                                   │&#xa;│  9. REPO return Entity ke USECASE       │&#xa;│     ↓                                   │&#xa;│  10. USECASE return result ke CUBIT     │&#xa;│     ↓                                   │&#xa;│  11. CUBIT emit state Success           │&#xa;│     ↓                                   │&#xa;│  12. PAGE rebuild (UI update)            │&#xa;└─────────────────────────────────────────┘" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#000000;fontSize=10;fontFamily=Times New Roman;size=15;" vertex="1" parent="1">
          <mxGeometry x="960" y="520" width="260" height="300" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
