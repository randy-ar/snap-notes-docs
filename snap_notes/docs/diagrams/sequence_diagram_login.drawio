        </mxCell>

        <mxCell id="legend_mapping" value="&lt;b&gt;MAPPING CLASS DIAGRAM:&lt;/b&gt;&#xa;&#xa;Flutter (MVVM):&#xa;  LoginPage → AuthViewModel → AuthService&#xa;&#xa;NestJS (MVC):&#xa;  AuthController → AuthService → SupabaseAuth&#xa;&#xa;&lt;b&gt;Penghubung:&lt;/b&gt; HTTP REST API&#xa;  AuthService (Flutter) ──HTTP──&gt; AuthController (NestJS)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;fontFamily=Times New Roman;size=15;align=left;spacingLeft=10;" vertex="1" parent="1">
